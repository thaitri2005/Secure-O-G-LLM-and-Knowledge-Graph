  "entity_types": {
    "Well": {
      "definition": "A drilled hole with its own name, such as AK-3, TG-2, 56-32 or 68-32",
      "examples": [
        "AK-3",
        "56-32"
      ],
      "sections": [
        "Well Information",
        "Well Data",
        "Summary",
        "Executive Summary"
      ]
    },
    "Project": {
      "definition": "The program or site a well belongs to, such as the Akutan Geothermal Project or Utah FORGE",
      "examples": [
        "Utah FORGE",
        "Akutan Geothermal Project"
      ],
      "sections": [
        "Introduction",
        "Summary"
      ]
    },
    "Organization": {
      "definition": "A company or agency acting as operator, drilling project manager, drilling contractor, service company or regulator",
      "examples": [
        "University of Utah",
        "Geothermal Resource Group",
        "City of Akutan"
      ],
      "sections": [
        "Well Information",
        "Permitting",
        "Introduction"
      ]
    },
    "Person": {
      "definition": "A named person with a role on the well or the report: prepared, reviewed or approved the report, supervisor, geologist",
      "examples": [
        "Mary Mann",
        "Ernesto Rivas"
      ],
      "sections": [
        "cover pages",
        "Core logging and Geology"
      ]
    },
    "Rig": {
      "definition": "The drilling rig, named by contractor and number",
      "examples": [
        "Frontier Rig-16"
      ],
      "sections": [
        "Well Information",
        "Mobilization",
        "Rig up"
      ]
    },
    "HoleSection": {
      "definition": "A drilled interval named by its bit size or role: conductor, surface, intermediate, production",
      "examples": [
        "12-1/4 in. hole",
        "Surface Section"
      ],
      "sections": [
        "Conductor",
        "Surface Section",
        "Intermediate Section",
        "Production Section",
        "6.2 to 6.4 hole sections"
      ]
    },
    "CasingString": {
      "definition": "A casing or liner run in a hole section, with outer diameter, weight, grade, connection and setting depth",
      "examples": [
        "13-3/8 in. casing"
      ],
      "sections": [
        "Casing and Cementing",
        "Casing Properties and Well Profiles",
        "Planned Wellbore Construction"
      ]
    },
    "Formation": {
      "definition": "A rock unit or lithology met at a depth, such as granite, basalt or ash tuff",
      "examples": [
        "granite",
        "Basalt and Andesite Lava"
      ],
      "sections": [
        "Lithology",
        "Core logging and Geology",
        "Alteration",
        "Permeability"
      ]
    },
    "Document": {
      "definition": "The report itself: an end-of-well or daily drilling report",
      "examples": [
        "End of Well Report Utah FORGE Seismic Monitoring Well 56-32"
      ],
      "sections": [
        "cover pages"
      ]
    }
