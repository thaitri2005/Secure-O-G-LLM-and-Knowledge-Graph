{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entity.schema.json",
  "title": "Registry entity",
  "description": "A canonical entity in the shared registry (design §5.7): an opaque ID, a profile-declared type, scoped identifiers and language-tagged names. An entity with an identifier gets an ID derived from it; otherwise from its type, scope and normalized name key.",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity_id", "entity_type", "profile", "identifiers", "names"],
  "properties": {
    "entity_id": {"type": "string", "pattern": "^ent:[a-f0-9]{24}$"},
    "entity_type": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "pattern": "^[a-z][a-z0-9_]*@[0-9A-Za-z.-]+$"},
    "identifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scheme", "value"],
        "properties": {"scheme": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}}
      }
    },
    "names": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "language", "scope"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "language": {"type": "string", "pattern": "^[a-z]{2,3}$|^und$"},
          "scope": {"type": ["string", "null"], "description": "Where the name is unambiguous, for example a project or lease"}
        }
      }
    }
  }
}
