{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "doc_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "chunk_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+#c[0-9]{4}$"
    },
    "type": {
      "enum": [
        "text",
        "table"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "section": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    },
    "char_start": {
      "type": "integer",
      "minimum": 0
    },
    "char_end": {
      "type": "integer",
      "minimum": 0
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          }
        },
        "required": [
          "page",
          "bbox"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "section_path": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parent_doc_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "table_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "row_start": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "row_end": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "source_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_ref": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "source_start": {
            "type": "integer",
            "minimum": 0
          },
          "source_end": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "source_ref",
          "page",
          "start",
          "end",
          "source_start",
          "source_end"
        ],
        "additionalProperties": false
      }
    },
    "table_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "table_id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+#t[0-9]{3}$"
          },
          "row_start": {
            "type": "integer",
            "minimum": 0
          },
          "row_end": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "table_id",
          "row_start",
          "row_end"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "doc_id",
    "page",
    "chunk_id",
    "type",
    "text",
    "section",
    "content_id",
    "char_start",
    "char_end",
    "regions",
    "section_path",
    "parent_doc_id",
    "table_id",
    "row_start",
    "row_end"
  ],
  "additionalProperties": false
}
