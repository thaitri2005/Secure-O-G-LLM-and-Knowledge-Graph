{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "k1_table.schema.json",
  "title": "K1 table",
  "description": "One logical table of a K1 file with its grid, cells and the physical parts it was assembled from. Track A proposal for Track C review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["table_id", "logical_id", "file_id", "doc_id", "pages", "grid", "header_rows", "num_rows", "num_cols",
               "cells", "parts", "join", "rows_text", "regions"],
  "properties": {
    "table_id": {"type": "string", "pattern": "^f[0-9a-f]{16}:t[1-9][0-9]*$"},
    "logical_id": {"type": "string"},
    "file_id": {"type": "string", "pattern": "^f[0-9a-f]{16}$"},
    "doc_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"},
    "pages": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
    "grid": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
    "header_rows": {"type": "integer", "minimum": 0},
    "num_rows": {"type": "integer", "minimum": 0},
    "num_cols": {"type": "integer", "minimum": 0},
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["r", "c", "row_span", "col_span", "text", "is_header"],
        "allOf": [{"if": {"required": ["ocr_unreadable"]}, "then": {"properties": {"text": {"const": ""}}}}],
        "properties": {
          "r": {"type": "integer", "minimum": 0},
          "c": {"type": "integer", "minimum": 0},
          "row_span": {"type": "integer", "minimum": 1},
          "col_span": {"type": "integer", "minimum": 1},
          "text": {"type": "string"},
          "is_header": {"type": "boolean"},
          "ocr_unreadable": {"const": true, "description": "Ink is present in this physical cell. The local OCR readers could not agree."}
        }
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_ref", "page", "bbox", "row_start", "row_end", "header"],
        "properties": {
          "source_ref": {"type": "string"},
          "page": {"type": "integer", "minimum": 1},
          "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
          "row_start": {"type": "integer", "minimum": 0},
          "row_end": {"type": "integer", "minimum": 0},
          "native_trimmed_rows": {"type": "integer", "minimum": 1, "description": "Leading native rows removed before this part was assembled."},
          "rendered_body_header_rows": {"type": "integer", "minimum": 1, "description": "Leading retained body rows that the native converter rendered as a header."},
          "scan_repairs": {
            "type": "array", "minItems": 1,
            "description": "OCR table cells with both the native read and the corroborated printed line.",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["r", "c", "previous", "value", "bbox"],
              "properties": {
                "r": {"type": "integer", "minimum": 0},
                "c": {"type": "integer", "minimum": 0},
                "previous": {"type": "string", "minLength": 1},
                "value": {"type": "string", "minLength": 1},
                "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}
              }
            }
          },
          "numeric_repairs": {
            "type": "array", "minItems": 1,
            "description": "Native grid indices, original value and printed cell rectangle for reconciled numeric cells.",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["r", "c", "previous", "value", "bbox"],
              "properties": {
                "r": {"type": "integer", "minimum": 0},
                "c": {"type": "integer", "minimum": 0},
                "previous": {"type": "string", "minLength": 1},
                "value": {"type": "string", "minLength": 1},
                "focus": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4,
                          "description": "Visible word box used when the native rectangle crosses a printed border."},
                "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}
              }
            }
          },
          "cell_sources": {
            "type": "array", "minItems": 1,
            "description": "Visible cell fragments on this page, using the logical row and column indices.",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["r", "c", "text", "bbox"],
              "properties": {
                "r": {"type": "integer", "minimum": 0},
                "c": {"type": "integer", "minimum": 0},
                "text": {"type": "string", "minLength": 1},
                "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}
              }
            }
          },
          "header": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}
        }
      }
    },
    "join": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasons"],
      "properties": {
        "status": {"enum": ["joined", "uncertain", "single"]},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "rows_text": {"type": "array", "items": {"type": "string"}},
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "bbox"],
        "properties": {
          "page": {"type": "integer", "minimum": 1},
          "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4,
                   "description": "left, top, right, bottom in PDF points, top-left origin"}
        }
      }
    }
  }
}
