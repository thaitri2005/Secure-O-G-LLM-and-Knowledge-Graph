{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "doc_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "title": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "landing_page": {
      "type": "string"
    },
    "license": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "url"
      ],
      "additionalProperties": false
    },
    "parser": {
      "type": "string"
    },
    "config_hash": {
      "type": "string"
    },
    "sha256": {
      "type": "string"
    },
    "gdr_submission": {
      "type": [
        "integer",
        "null"
      ]
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "page_count": {
      "type": "integer",
      "minimum": 1
    },
    "parent_doc_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "pages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rotation": {
            "type": "integer"
          },
          "needs_ocr": {
            "type": "boolean"
          }
        },
        "required": [
          "width",
          "height",
          "rotation",
          "needs_ocr"
        ],
        "additionalProperties": false
      }
    },
    "original_filename": {
      "type": "string"
    },
    "ocr": {
      "type": "object",
      "required": [
        "settings",
        "pages"
      ],
      "additionalProperties": false,
      "properties": {
        "settings": {
          "type": "object",
          "required": [
            "languages",
            "mode",
            "confidence_threshold"
          ],
          "additionalProperties": false,
          "properties": {
            "languages": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z]{2,3}(_[a-z]+)?$"
              }
            },
            "mode": {
              "enum": [
                "auto",
                "full_page"
              ]
            },
            "confidence_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "page",
              "attributed_characters",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "attributed_characters": {
                "type": "integer",
                "minimum": 0
              },
              "status": {
                "enum": [
                  "missing",
                  "review",
                  "covered"
                ]
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "doc_id",
    "title",
    "source_url",
    "landing_page",
    "license",
    "parser",
    "config_hash",
    "sha256",
    "gdr_submission",
    "bytes",
    "page_count",
    "parent_doc_id",
    "pages"
  ],
  "additionalProperties": false
}
