# On-prem runtime environment. Relative paths resolve against the project root.
# Loaded by scripts/onprem_env.ps1 (kgb.ps1) and kgbuilder.runtime.onprem.load_env().
# Every endpoint is localhost; the keys are LM Studio dummies, not secrets.

# Local model server (LM Studio)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_BASE=http://127.0.0.1:1234/v1
LM_STUDIO_API_BASE=http://127.0.0.1:1234/v1
OPENAI_API_KEY=lm-studio
OPENAI_KEY=lm-studio
LM_STUDIO_API_KEY=lm-studio

# Telemetry off
LITELLM_LOCAL_MODEL_COST_MAP=True
DO_NOT_TRACK=1
ANONYMIZED_TELEMETRY=False

# Caches and temp kept inside the project
PIP_CACHE_DIR=./.cache/pip
HF_HOME=./.cache/hf
# SENTENCE_TRANSFORMERS_HOME stays unset: sentence-transformers 3.0.1 (EDC) would use it as a
# separate cache instead of HF_HOME/hub, where fetch_assets.py puts the snapshots.
TORCH_HOME=./.cache/torch
TIKTOKEN_CACHE_DIR=./.cache/tiktoken
NLTK_DATA=./.cache/nltk
DSPY_CACHEDIR=./.cache/dspy
TEMP=./.cache/tmp
TMP=./.cache/tmp

# Offline after the one-time asset download (set to 0 only inside setup_venvs.ps1)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1

# Upstream code opens files without an encoding argument
PYTHONUTF8=1
# Keep third_party/ clones pristine (no __pycache__ next to upstream sources)
PYTHONDONTWRITEBYTECODE=1
TOKENIZERS_PARALLELISM=false
# Only effective when set before Python starts (dot-source onprem_env.ps1 first)
PYTHONHASHSEED=0

# No proxy for anything: a non-empty value stops urllib.getproxies() from reading the
# Windows registry proxy, and "*" disables proxies in urllib, httpx and requests.
NO_PROXY=*
no_proxy=*
GRAPHITI_TELEMETRY_ENABLED=false
RAGAS_DO_NOT_TRACK=true
KGB_NEO4J_URI=bolt://127.0.0.1:7687
