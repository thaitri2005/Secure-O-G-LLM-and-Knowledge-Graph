# Settings for platform/docker-compose.yml. Copy to platform/.env (next to the compose file, which is where compose
# looks) and fill in. A laptop needs no .env at all: every variable has a local default in the compose file.
# A server MUST set the three passwords marked below; the defaults are public. Never commit the filled-in file.
# Values with a "$" in them (the password hash) go in single quotes. deploy/README.md walks through each step.

# Which services `docker compose up -d` starts: app = backend and proxy; demo = the stub model (no GPU, not a model).
COMPOSE_PROFILES=app

# ---- the stores -------------------------------------------------------------------------------------------------
# MUST SET on a server. Letters and digits only (it sits inside a URL): openssl rand -hex 24
POSTGRES_PASSWORD=change-me-letters-and-digits
# MUST SET on a server. At least 8 characters: openssl rand -hex 24
NEO4J_PASSWORD=change-me-letters-and-digits
# Only with --profile objectstore.
MINIO_ROOT_PASSWORD=change-me-letters-and-digits

# ---- the backend ------------------------------------------------------------------------------------------------
# files: the committed end-of-well bundle in the image; stores: PostgreSQL and Neo4j, after a release is loaded.
BACKEND_SOURCE=stores
# Leave unset to use postgresql://kg:<POSTGRES_PASSWORD>@postgres:5432/kg, the compose network's database.
# BACKEND_DSN=postgresql://kg:<password>@postgres:5432/kg
# The models: copies of configs/graphrag/endpoints.json and roles.json kept on the server (absolute paths).
# Unset, every local endpoint is the stub model and the roles are the repository's.
MODEL_ENDPOINTS_FILE=/srv/kg/models/endpoints.json
MODEL_ROLES_FILE=/srv/kg/models/roles.json
# Only if the roles file names the openrouter endpoint (open-weight models, public data only).
OPENROUTER_API_KEY=
# Only if the endpoints file names DESKTOP_MODEL_KEY: the --api-key llama-server was started with on Tri's desktop.
DESKTOP_MODEL_KEY=
# Page images, <file_id>/p<n>.png, written by platform/render_pages.py.
PAGE_IMAGES_DIR=/srv/kg/pages

# ---- the proxy --------------------------------------------------------------------------------------------------
# A domain whose DNS points at the server gives automatic HTTPS; :80 gives plain HTTP (laptop, or behind a tunnel).
SITE_ADDRESS=kg.example.org
# The one shared user name and password given to the experts with the link.
APP_USER=team
# MUST SET. The bcrypt hash of the shared password, in single quotes:
#   docker run --rm caddy:2.11.9-alpine caddy hash-password --plaintext '<password>'
APP_PASSWORD_HASH='$2a$14$replace-with-the-output-of-caddy-hash-password'
# 0.0.0.0 on a server so the internet reaches ports 80 and 443; the default 127.0.0.1 keeps a laptop private.
PROXY_BIND=0.0.0.0
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
