# Copy to platform/.env and fill in. Docker Compose reads platform/.env for platform/docker-compose.yml.
# platform/.env is ignored by Git: the repository is public, so never commit it.
#
# On a laptop whose stores were created before 24 November 2026, keep the old development password
# (platform-dev): PostgreSQL and Neo4j only read these on their first start, with an empty volume.
# On the shared server, use long random passwords, for example: openssl rand -base64 24
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
# MinIO is optional (--profile objectstore); without a value it keeps the development password.
MINIO_ROOT_PASSWORD=
