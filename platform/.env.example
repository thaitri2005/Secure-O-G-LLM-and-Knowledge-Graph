# Settings for platform/docker-compose.yml. Copy to platform/.env (next to the compose file, which is where compose
# looks) and fill in. platform/.env is ignored by Git: the repository is public, so never commit it.
#
# The two store passwords are required: compose refuses to start without them (C-C13).
# On a laptop whose stores were created before 24 November 2026, keep the old development password
# (platform-dev): PostgreSQL and Neo4j only read these on their first start, with an empty volume.
# On the shared server, use long random passwords of letters and digits (they sit inside a URL): openssl rand -hex 24
# Values with a "$" in them (the password hash) go in single quotes.
# The stores: docs/tracks/C-storage/server-runbook.md. The application on top of them: deploy/README.md.

# ---- the stores (always needed) -----------------------------------------------------------------------------------
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
# MinIO is optional (--profile objectstore); without a value it keeps the development password.
MINIO_ROOT_PASSWORD=

# ---- the application (only with --profile app; a machine that runs the stores alone can leave all of this out) ----
# Which services `docker compose up -d` starts: app = backend and proxy; demo = the stub model (no GPU, not a model).
COMPOSE_PROFILES=app

# ---- the backend ------------------------------------------------------------------------------------------------
# files: the committed end-of-well bundle in the image; stores: PostgreSQL and Neo4j, after a release is loaded.
BACKEND_SOURCE=stores
# Leave unset to use postgresql://kg:<POSTGRES_PASSWORD>@postgres:5432/kg, the compose network's database.
# BACKEND_DSN=postgresql://kg:<password>@postgres:5432/kg
# The models: copies of configs/graphrag/endpoints.json and roles.json kept on the server (absolute paths).
# Unset, every local endpoint is the stub model and the roles are the repository's.
MODEL_ENDPOINTS_FILE=/srv/kg/models/endpoints.json
MODEL_ROLES_FILE=/srv/kg/models/roles.json
# Only if the roles file names the openrouter endpoint (open-weight models, public data only).
OPENROUTER_API_KEY=
# Only if the endpoints file names DESKTOP_MODEL_KEY: the --api-key llama-server was started with on Tri's desktop.
DESKTOP_MODEL_KEY=
# REQUIRED when the roles file names a hosted endpoint: the packages that may be sent to it, by name, comma-separated.
# Naming a package here states that every report in it is public. The backend refuses to start otherwise.
BACKEND_PUBLIC_RELEASES=
# Seconds one model call may take, seconds a question waits for its turn, and how many questions may wait.
# The defaults suit a GPU or a hosted model; a model on a CPU needs far more (and the browser's limit with them).
# BACKEND_MODEL_TIMEOUT=75
# BACKEND_QUEUE_SECONDS=60
# BACKEND_MAX_WAITING=8
# Memory. The defaults fit a server with 4 GB; raise Neo4j's for a graph of many wells.
# NEO4J_HEAP=512m
# NEO4J_PAGECACHE=256m
# NEO4J_MEMORY=1536m
# POSTGRES_MEMORY=1g
# BACKEND_MEMORY=1536m
# Page images, <file_id>/p<n>.png, written by platform/render_pages.py.
PAGE_IMAGES_DIR=/srv/kg/pages

# ---- the proxy --------------------------------------------------------------------------------------------------
# A domain whose DNS points at the server gives automatic HTTPS; :80 gives plain HTTP (laptop, or behind a tunnel).
SITE_ADDRESS=kg.example.org
# The one shared user name and password given to the experts with the link.
APP_USER=team
# MUST SET. The bcrypt hash of the shared password, in single quotes:
#   docker run --rm caddy:2.11.9-alpine caddy hash-password --plaintext '<password>'
APP_PASSWORD_HASH='$2a$14$replace-with-the-output-of-caddy-hash-password'
# 0.0.0.0 on a server so the internet reaches ports 80 and 443; the default 127.0.0.1 keeps a laptop private.
PROXY_BIND=0.0.0.0
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
